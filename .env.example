[TEMPLATE]
# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"

# --- Optional: Azure Speech fallback for /api/edge-tts ---
# Microsoft periodically breaks the free Edge TTS endpoint that edge-tts uses
# (last: Oct 10, 2026). When it breaks, requests automatically fall back to
# Azure Speech, which serves the same neural voices and has a free tier
# (F0: 500K characters/month).
# Get keys: Azure Portal > Speech service > Keys & Endpoint
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""   # e.g. "westus", "westeurope", "southeastasia"

# Optional extras:
# EDGE_TTS_DISABLED="true"   # skip edge-tts entirely, always use Azure
# AZURE_TTS_URL=""           # full endpoint override (testing / sovereign clouds)
